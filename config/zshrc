# ~/.zshrc — managed by linux-setup

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # using starship instead of an oh-my-zsh theme
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# starship prompt
eval "$(starship init zsh)"

# aliases — tweak to taste
alias ll="ls -lah"
alias gs="git status"
alias gc="git commit -m"
alias gp="git push"
alias update="sudo dnf upgrade -y 2>/dev/null || sudo pacman -Syu --noconfirm 2>/dev/null || sudo apt update && sudo apt upgrade -y"
