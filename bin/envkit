#!/usr/bin/env python3
"""
bin/envkit — CLI & GUI frontend entrypoint for envkit
"""

import argparse
import os
import sys
import shutil
import socket
import urllib.request
from pathlib import Path
from typing import List, Optional

# Add project root to sys.path
PROJECT_ROOT = Path(__file__).resolve().parent.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from core.catalog import Catalog
from core.detector import Detector
from core.distro import detect_distro
from core.installer import AppStatus, InstallRunner
from core.logger import get_logger, setup_logger
from core.privilege import has_sudo, is_root
from core.profiles import Profile, ProfileManager

logger = setup_logger("envkit_cli")

# Terminal Color Codes
GREEN = "\033[1;32m"
YELLOW = "\033[1;33m"
RED = "\033[1;31m"
BLUE = "\033[1;34m"
CYAN = "\033[1;36m"
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"


def print_banner():
    banner = f"""{CYAN}{BOLD}
    ==========================================================
                  envkit — Workstation Builder
              Modular Cross-Distro Linux Software Setup
    =========================================================={RESET}"""
    print(banner)


def cmd_doctor(args):
    """Run system and environment diagnostic checks."""
    print(f"\n{BOLD}envkit doctor — Diagnostic Check{RESET}\n")
    distro = detect_distro()

    # 1. Distro check
    if distro.family != "unknown":
        print(f"  {GREEN}✓{RESET} Linux distribution: {BOLD}{distro.pretty_name}{RESET} (family: {distro.family})")
    else:
        print(f"  {YELLOW}!{RESET} Unknown or unsupported distribution: {distro.id}")

    # 2. Package manager
    if distro.package_manager != "unknown" and shutil.which(distro.package_manager):
        extra = f" (version: {distro.dnf_version})" if distro.dnf_version else ""
        if distro.aur_helper:
            extra += f" + {distro.aur_helper} (AUR)"
        print(f"  {GREEN}✓{RESET} Native package manager: {BOLD}{distro.package_manager}{RESET}{extra}")
    else:
        print(f"  {RED}✕{RESET} Native package manager not detected or not found in PATH")

    # 3. Sudo availability
    if is_root():
        print(f"  {YELLOW}!{RESET} Running as root (envkit should ideally run as normal user with sudo access)")
    elif has_sudo():
        print(f"  {GREEN}✓{RESET} sudo utility available")
    else:
        print(f"  {RED}✕{RESET} sudo not available")

    # 4. Internet connectivity
    has_internet = False
    try:
        socket.create_connection(("1.1.1.1", 53), timeout=3)
        has_internet = True
    except OSError:
        pass

    if has_internet:
        print(f"  {GREEN}✓{RESET} Internet connection active")
    else:
        print(f"  {YELLOW}!{RESET} Internet connectivity check failed")

    # 5. Flatpak availability
    if shutil.which("flatpak"):
        print(f"  {GREEN}✓{RESET} Flatpak available")
    else:
        print(f"  {YELLOW}!{RESET} Flatpak not installed (some GUI packages might not be available)")

    # 6. Desktop environment
    print(f"  {GREEN}✓{RESET} Desktop environment: {BOLD}{distro.desktop}{RESET}")

    # 7. Architecture & shell
    print(f"  {GREEN}✓{RESET} Architecture: {distro.arch}")
    print(f"  {GREEN}✓{RESET} Shell: {distro.shell}")

    # 8. GUI framework (PySide6)
    try:
        import PySide6
        print(f"  {GREEN}✓{RESET} PySide6 Qt6 framework available ({PySide6.__version__})")
    except ImportError:
        print(f"  {YELLOW}!{RESET} PySide6 not installed (GUI will fallback to CLI)")

    print(f"\n{GREEN}{BOLD}System check complete.{RESET}\n")


def cmd_list(args):
    """List catalog applications with category and installed status."""
    catalog = Catalog()
    distro = detect_distro()
    detector = Detector(distro)

    category_filter = args.category.lower() if args.category else None
    apps = catalog.list_all()

    if category_filter:
        apps = [a for a in apps if a.category.lower() == category_filter]
        if not apps:
            print(f"{YELLOW}No applications found in category '{category_filter}'.{RESET}")
            print(f"Available categories: {', '.join(catalog.get_categories())}")
            return

    print(f"\n{BOLD}{'ID':<18} {'NAME':<28} {'CATEGORY':<15} {'STATUS'}{RESET}")
    print("-" * 75)

    for app in apps:
        status, _ = detector.is_installed(app)
        if status == "installed":
            status_badge = f"{GREEN}✓ Installed{RESET}"
        else:
            status_badge = f"{DIM}Available{RESET}"
        print(f"{app.id:<18} {app.name:<28} {app.category:<15} {status_badge}")

    print(f"\nTotal: {len(apps)} applications listed.\n")


def cmd_search(args):
    """Search catalog applications."""
    catalog = Catalog()
    distro = detect_distro()
    detector = Detector(distro)

    results = catalog.search(args.query)
    if not results:
        print(f"\n{YELLOW}No applications matched '{args.query}'.{RESET}\n")
        return

    print(f"\n{BOLD}Search results for '{args.query}':{RESET}\n")
    for app in results:
        status, _ = detector.is_installed(app)
        status_badge = f"{GREEN}[Installed]{RESET}" if status == "installed" else f"{CYAN}[Available]{RESET}"
        tags_str = f"({', '.join(app.tags[:4])})" if app.tags else ""
        print(f"  {BOLD}{app.name}{RESET} ({app.id}) {status_badge}")
        print(f"    {app.description}")
        print(f"    Category: {app.category}  {DIM}{tags_str}{RESET}")
        print()


def cmd_installed(args):
    """Show installed applications detected from the catalog."""
    catalog = Catalog()
    distro = detect_distro()
    detector = Detector(distro)

    installed_apps = []
    for app in catalog.list_all():
        status, detail = detector.is_installed(app)
        if status == "installed":
            installed_apps.append((app, detail))

    print(f"\n{BOLD}Installed Applications ({len(installed_apps)} detected):{RESET}\n")
    for app, detail in installed_apps:
        print(f"  {GREEN}✓{RESET} {BOLD}{app.name}{RESET} ({app.id}) — {DIM}{detail}{RESET}")
    print()


def cmd_install(args):
    """Install specified applications."""
    if not args.apps:
        print(f"{RED}Error: Please specify one or more application IDs to install.{RESET}")
        print("Example: envkit install git vscode docker")
        sys.exit(1)

    catalog = Catalog()
    distro = detect_distro()
    detector = Detector(distro)

    # Validate IDs
    selected_apps = []
    missing_ids = []
    for app_id in args.apps:
        app = catalog.get(app_id)
        if app:
            selected_apps.append(app)
        else:
            missing_ids.append(app_id)

    if missing_ids:
        print(f"{RED}Error: Unknown application IDs: {', '.join(missing_ids)}{RESET}")
        sys.exit(1)

    # Summary
    already_installed = []
    will_install = []
    for app in selected_apps:
        status, detail = detector.is_installed(app)
        if status == "installed" and not args.force:
            already_installed.append((app, detail))
        else:
            will_install.append(app)

    print(f"\n{BOLD}Installation Summary:{RESET}")
    print(f"  Target Distro: {distro.pretty_name} (Family: {distro.family})")
    print(f"  Package Manager: {distro.package_manager}")
    print(f"  Total Selected: {len(selected_apps)}")

    if already_installed:
        print(f"\n{GREEN}Already installed ({len(already_installed)}):{RESET}")
        for app, detail in already_installed:
            print(f"  ✓ {app.name} ({detail})")

    if will_install:
        print(f"\n{CYAN}Will install ({len(will_install)}):{RESET}")
        for app in will_install:
            action = catalog.resolve_install_action(app.id, distro)
            mgr = action.manager_name
            pkgs = " ".join(action.packages) if action.packages else "official script"
            print(f"  + {BOLD}{app.name}{RESET} via {mgr} ({pkgs})")
    else:
        print(f"\n{GREEN}All selected applications are already installed! Nothing to do.{RESET}\n")
        return

    # Confirmation
    if not args.yes:
        confirm = input(f"\nProceed with installation? [Y/n] ").strip().lower()
        if confirm and confirm not in ("y", "yes"):
            print("Aborted.")
            return

    # Runner
    runner = InstallRunner(distro, catalog, detector, dry_run=args.dry_run)

    def on_app_status(app_id, status, msg):
        app = catalog.get(app_id)
        name = app.name if app else app_id
        if status == AppStatus.INSTALLING:
            print(f"  {CYAN}⟳{RESET} Installing {BOLD}{name}{RESET}...", end="", flush=True)
        elif status == AppStatus.SUCCESS:
            print(f"\r  {GREEN}✓{RESET} {BOLD}{name}{RESET} — Installed successfully!")
        elif status == AppStatus.FAILED:
            print(f"\r  {RED}✕{RESET} {BOLD}{name}{RESET} — {RED}Failed{RESET}: {msg}")
        elif status == AppStatus.ALREADY_INSTALLED:
            print(f"  {GREEN}✓{RESET} {BOLD}{name}{RESET} — Already installed")
        elif status == AppStatus.UNAVAILABLE:
            print(f"  {YELLOW}!{RESET} {BOLD}{name}{RESET} — Unavailable: {msg}")

    runner.on_app_status = on_app_status

    print(f"\n{BOLD}Starting installation...{RESET}")
    results = runner.run_queue([a.id for a in selected_apps], skip_installed=not args.force)

    # Summary
    successes = sum(1 for r in results.values() if r.status in (AppStatus.SUCCESS, AppStatus.ALREADY_INSTALLED))
    failures = sum(1 for r in results.values() if r.status == AppStatus.FAILED)

    print(f"\n{BOLD}Installation Results:{RESET}")
    print(f"  {GREEN}✓ {successes} succeeded / already present{RESET}")
    if failures > 0:
        print(f"  {RED}✕ {failures} failed{RESET}")
        for r in results.values():
            if r.status == AppStatus.FAILED:
                print(f"    - {r.app_name}: {r.message}")
    print()


def cmd_profiles(args):
    """List available profiles."""
    pm = ProfileManager()
    profiles = pm.list_all()

    print(f"\n{BOLD}Available Workstation Profiles:{RESET}\n")
    for p in profiles:
        kind = f"{CYAN}[Custom]{RESET}" if p.is_custom else f"{GREEN}[Built-in]{RESET}"
        print(f"  {BOLD}{p.name}{RESET} ({p.id}) {kind}")
        print(f"    {p.description}")
        print(f"    Apps ({len(p.apps)}): {', '.join(p.apps[:8])}{'...' if len(p.apps) > 8 else ''}")
        print()


def cmd_install_profile(args):
    """Install all applications defined in a profile."""
    pm = ProfileManager()
    profile = pm.get_profile(args.profile)
    if not profile:
        print(f"{RED}Error: Profile '{args.profile}' not found.{RESET}")
        print("Run 'envkit profiles' to see available profiles.")
        sys.exit(1)

    print(f"\n{BOLD}Selected Profile:{RESET} {profile.name}")
    print(f"Description: {profile.description}")
    print(f"Applications ({len(profile.apps)}): {', '.join(profile.apps)}")

    # Delegate to cmd_install
    install_args = argparse.Namespace(
        apps=profile.apps,
        yes=args.yes,
        force=args.force,
        dry_run=args.dry_run
    )
    cmd_install(install_args)


def cmd_export(args):
    """Export workstation setup or custom profile."""
    target_path = args.output
    pm = ProfileManager()

    if args.profile:
        prof = pm.get_profile(args.profile)
        if not prof:
            print(f"{RED}Profile '{args.profile}' not found.{RESET}")
            sys.exit(1)
    else:
        # Export detected installed apps from catalog
        catalog = Catalog()
        distro = detect_distro()
        detector = Detector(distro)
        installed_ids = []
        for app in catalog.list_all():
            st, _ = detector.is_installed(app)
            if st == "installed":
                installed_ids.append(app.id)

        prof = Profile(
            id="my-setup",
            name="My Workstation Setup",
            description=f"Exported workstation configuration from {distro.pretty_name}",
            apps=installed_ids
        )

    out = pm.export_profile(prof, target_path)
    print(f"{GREEN}✓ Profile exported successfully to {out}{RESET}")


def interactive_cli():
    """Fallback interactive terminal UI."""
    print_banner()
    distro = detect_distro()
    print(f"Detected: {BOLD}{distro.pretty_name}{RESET} (package manager: {distro.package_manager})")
    print(f"Desktop:  {distro.desktop}\n")

    catalog = Catalog()
    detector = Detector(distro)

    categories = catalog.get_categories()

    print("What would you like to do?")
    print("  [1] Browse and install applications by category")
    print("  [2] Select a predefined profile (Developer, Student, Security, etc.)")
    print("  [3] Search for applications")
    print("  [4] View installed applications")
    print("  [5] Run system diagnostic (doctor)")
    print("  [6] Launch graphical interface (GUI)")
    print("  [0] Exit")

    choice = input("\nEnter choice [0-6]: ").strip()
    if choice == "1":
        print("\nCategories:")
        for idx, cat in enumerate(categories, start=1):
            print(f"  [{idx}] {cat.capitalize()}")
        cat_idx = input(f"\nSelect category [1-{len(categories)}]: ").strip()
        try:
            selected_cat = categories[int(cat_idx) - 1]
            apps = catalog.get_by_category(selected_cat)
            print(f"\nApplications in {selected_cat.capitalize()}:")
            for i, app in enumerate(apps, start=1):
                st, _ = detector.is_installed(app)
                badge = f"{GREEN}✓ Installed{RESET}" if st == "installed" else f"{CYAN}Available{RESET}"
                print(f"  [{i}] {app.name:<25} {badge}")
            selection = input("\nEnter numbers of apps to install (separated by space, or 'all'): ").strip()
            if not selection:
                return
            to_install = []
            if selection.lower() == "all":
                to_install = [a.id for a in apps]
            else:
                for num in selection.split():
                    try:
                        to_install.append(apps[int(num) - 1].id)
                    except (ValueError, IndexError):
                        pass
            if to_install:
                args = argparse.Namespace(apps=to_install, yes=False, force=False, dry_run=False)
                cmd_install(args)
        except (ValueError, IndexError):
            print("Invalid category.")
    elif choice == "2":
        cmd_profiles(None)
        p_name = input("Enter profile ID to install: ").strip()
        if p_name:
            args = argparse.Namespace(profile=p_name, yes=False, force=False, dry_run=False)
            cmd_install_profile(args)
    elif choice == "3":
        q = input("Search query: ").strip()
        if q:
            cmd_search(argparse.Namespace(query=q))
    elif choice == "4":
        cmd_installed(None)
    elif choice == "5":
        cmd_doctor(None)
    elif choice == "6":
        launch_gui()
    else:
        print("Goodbye!")


def launch_gui():
    """Launch PySide6 GUI."""
    try:
        from gui.app import run_gui
        run_gui()
    except ImportError as e:
        print(f"{RED}Error: PySide6 GUI dependencies not available: {e}{RESET}")
        print("Falling back to interactive CLI...")
        interactive_cli()
    except Exception as e:
        print(f"{RED}Error launching GUI: {e}{RESET}")
        print("Falling back to interactive CLI...")
        interactive_cli()


def main():
    parser = argparse.ArgumentParser(
        prog="envkit",
        description="envkit — Modular Linux Software Installer and Workstation Setup Tool"
    )
    parser.add_argument("--gui", action="store_true", help="Force launch the Qt graphical interface")
    parser.add_argument("--cli", action="store_true", help="Force launch the interactive CLI interface")

    subparsers = parser.add_subparsers(dest="command", help="Subcommand to execute")

    # doctor
    subparsers.add_parser("doctor", help="Check system environment, dependencies, and health")

    # list
    p_list = subparsers.add_parser("list", help="List available catalog applications")
    p_list.add_argument("-c", "--category", help="Filter by category")

    # search
    p_search = subparsers.add_parser("search", help="Search applications by name, tag, or description")
    p_search.add_argument("query", help="Search keyword")

    # installed
    subparsers.add_parser("installed", help="List already installed applications")

    # install
    p_install = subparsers.add_parser("install", help="Install selected applications")
    p_install.add_argument("apps", nargs="+", help="Application IDs to install")
    p_install.add_argument("-y", "--yes", action="store_true", help="Skip confirmation prompt")
    p_install.add_argument("-f", "--force", action="store_true", help="Reinstall even if already installed")
    p_install.add_argument("--dry-run", action="store_true", help="Simulate installation without making system changes")

    # profiles
    subparsers.add_parser("profiles", help="List predefined and custom workstation profiles")

    # install-profile
    p_inst_prof = subparsers.add_parser("install-profile", help="Install all applications from a profile")
    p_inst_prof.add_argument("profile", help="Profile ID, name, or path to profile YAML")
    p_inst_prof.add_argument("-y", "--yes", action="store_true", help="Skip confirmation prompt")
    p_inst_prof.add_argument("-f", "--force", action="store_true", help="Reinstall even if already installed")
    p_inst_prof.add_argument("--dry-run", action="store_true", help="Simulate installation without making changes")

    # export
    p_export = subparsers.add_parser("export", help="Export setup or profile to a YAML file")
    p_export.add_argument("output", help="Path to destination YAML file")
    p_export.add_argument("-p", "--profile", help="Specific profile to export (defaults to current installed apps)")

    args = parser.parse_args()

    # Route subcommands
    if args.command == "doctor":
        cmd_doctor(args)
    elif args.command == "list":
        cmd_list(args)
    elif args.command == "search":
        cmd_search(args)
    elif args.command == "installed":
        cmd_installed(args)
    elif args.command == "install":
        cmd_install(args)
    elif args.command == "profiles":
        cmd_profiles(args)
    elif args.command == "install-profile":
        cmd_install_profile(args)
    elif args.command == "export":
        cmd_export(args)
    else:
        # Default behavior when no subcommand
        if args.gui:
            launch_gui()
        elif args.cli:
            interactive_cli()
        else:
            # Detect whether GUI is viable
            has_display = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
            try:
                import PySide6
                has_pyside = True
            except ImportError:
                has_pyside = False

            if has_display and has_pyside:
                launch_gui()
            else:
                interactive_cli()


if __name__ == "__main__":
    main()
